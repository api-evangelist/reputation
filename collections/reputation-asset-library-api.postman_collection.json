                        "content": "<p>(Required) Choose one or multiple image files from your computer. There's no limit to how many you can upload.</p>\n",
                        "type": "text/plain"
                      },
                      "key": "images",
                      "value": "<binary>",
                      "type": "text"
                    },
                    {
                      "description": {
                        "content": "<p>Provide a valid JSON string with image file names as keys and their respective tags as values. For example: {\"image1.jpg\": [\"tag1\", \"tag2\"], \"image2.jpg\": [\"tag2\", \"tag3\"]}.</p>\n",
                        "type": "text/plain"
